{
  "name": "@ned/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ned": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts run",
