{
  "description": "Ned 세션 이벤트 기록 — 각 이벤트를 $NED_HOME/events/YYYY-MM-DD.jsonl 에 한 줄로 남기고 늘 {} 로 답한다(차단 없음).",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/packages/hook/ned-hook.sh\"", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/packages/hook/ned-hook.sh\"", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/packages/hook/ned-hook.sh\"", "timeout": 5 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/packages/hook/ned-hook.sh\"", "timeout": 5 }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/packages/hook/ned-hook.sh\"", "timeout": 5 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/packages/hook/ned-hook.sh\"", "timeout": 5 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/packages/hook/ned-hook.sh\"", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/packages/hook/ned-hook.sh\"", "timeout": 5 }] }]
  }
}
